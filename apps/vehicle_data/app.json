{
  "id": "vehicle_data",
  "title": "Vehicle Data",
  "description": "Mileage, service due messages, the car's service history, check-control messages, tyre pressures, fault memory and DPF values, read-only. Shares them with your private BMW AI server.",
  "version": "0.2.7",
  "vendor": "custom",
  "loggingId": "OVD1",
  "iconGlyph": "service",
  "signals": {
    "de.bmw.infrastructure.SecureMileage": {
      "mileage": "rs"
    },
    "de.bmw.infrastructure.MileageSupreme": {
      "mileageSupreme": "rs"
    },
    "de.bmw.infotainment.ConditionBasedServicesLegacy": {
      "cBSMessageEngineOil": "s",
      "cBSMessageBrakeFront": "s",
      "cBSMessageBrakeRear": "s",
      "cBSMessageGearOil": "s",
      "cBSMessageParticleFilter": "s",
      "cBSMessageSparkPlug": "s"
    },
    "com.harman.infotainment.systemfunctions.servicehistory.ServiceHistory": {
      "_instances": "SystemFunctionsServiceHistoryInst1",
      "_methods": [
        "readServiceHistory"
      ],
      "_broadcasts": [
        "serviceHistoryUpdated"
      ]
    },
    "de.bmw.infotainment.checkcontrol.CheckControlMaster": {
      "basicList": "rs"
    },
    "de.bmw.infotainment.KombiInterface_2": {
      "newCCMessage": "s",
      "_methods": [
        "requestCCMessage"
      ]
    },
    "de.bmw.infotainment.vehicle.TPMSInternalData": {
      "tpmsInternalLastValues": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Vehicle Data",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_REFRESH",
          "Read service history and fault memory again"
        ]
      ]
    }
  ],
  "settings": [],
  "mguAppStartType": "autostart"
}
