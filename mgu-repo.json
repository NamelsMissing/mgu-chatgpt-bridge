        "ID7"
      ],
      "uninstallable": true
    },
    {
      "id": "mgu-ai-agent",
      "kind": "tool",
      "title": "BMW AI Companion Agent",
      "version": "0.2.1",
      "path": "native/mgu-ai-agent",
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true
    }
  ]
}
