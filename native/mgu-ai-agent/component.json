{
  "id": "mgu-ai-agent",
  "kind": "tool",
  "version": "0.2.16",
  "title": "BMW AI Companion Agent",
  "description": "Private MGU companion: full shell and file access for the paired Pi (web console, approved Claude jobs) and QR link to the Pi web terminal",
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "agent.js",
      "mode": "0644"
    },
    {
      "path": "vehicle-capabilities.js",
      "mode": "0644"
    },
    {
      "path": "telemetry-outbox.js",
      "mode": "0644"
    },
    {
      "path": "shell.js",
      "mode": "0644"
    },
    {
      "path": "apps.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "mgu-ai-agent.service",
      "from": "mgu-ai-agent.service"
    }
  ],
  "enable": [
    {
      "unit": "mgu-ai-agent.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "mgu-ai-agent"
  ],
  "restart": [
    "mgu-ai-agent.service"
  ],
  "uninstallable": true
}
