{
  "id": "mgu-ai-agent",
  "kind": "tool",
  "version": "0.2.2",
  "title": "BMW AI Companion Agent",
  "description": "Private BMW AI companion with read-only, owner-approved MGU command console; no unrestricted shell.",
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "agent.js",
      "mode": "0644"
    },
    {
      "path": "console-readonly.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "mgu-ai-agent.service",
      "from": "mgu-ai-agent.service"
    }
  ],
  "enable": [
    {
      "unit": "mgu-ai-agent.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "mgu-ai-agent"
  ],
  "restart": [
    "mgu-ai-agent.service"
  ],
  "uninstallable": true
}
